## FISH ANALYSIS ##
fishdata <- read.csv('data.csv')

# summing acoustic depth layers
# Sum schools and fish counts across depth intervals
fish_totals <- fishdata %>%
  group_by(Interval) %>%
  summarise(school.NASC = sum(school.NASC),
            n.fish = sum(n.fish))

# Select one row per Interval for all other columns
fish_other <- fishdata %>%
  distinct(Interval, .keep_all = TRUE) %>%
  dplyr::select(-school.NASC, -n.fish)

# Combine
fishdata_sum <- fish_other %>%
  left_join(fish_totals, by = "Interval")

fishdata_sf = st_as_sf(fishdata_sum, coords = c("lon", "lat"), crs = 4326)

# Creating buffer to remove points on land
fishdataa_proj <- st_transform(fishdata_sf, 32630) # Transform to UTM for accurate metre-based buffer
coastdata_proj <- st_transform(coast, 32630)
coastal_buffer <- st_buffer(coastdata_proj, 20) # Create 20m coastal buffer

fishdata_ocean <- fishdataa_proj[!apply(st_intersects(
  fishdataa_proj,
  coastal_buffer,
  sparse = FALSE
), 1, any), ] # Remove points within buffer and on land

fishdata_ocean <- st_transform(fishdata_ocean, 4326) # Transform back to 4326

## Adding region column to fish dataframe
fishdata_ocean <- st_join(fishdata_ocean, segments["region"]) # adding region column

# Reordering regions
fishdata_ocean$region <- factor(fishdata_ocean$region, 
                                levels = c("north", "north_channel", "south_channel", "south"))

# Reordering tidal factor
fishdata_ocean$tide <- factor(fishdata_ocean$tide, levels = c("flood", "ebb"))

############### GLMS ################################################################################################
colSums(is.na(fishdata_ocean[c("n.fish", "tide", "region")]))
fishdata_ocean <- fishdata_ocean[!is.na(fishdata_ocean$region), ] # removing NAs 

## Full Study Site - Fish Shoals Predicted by Tide GLM 
shoals_glm_tweedie <- glm(school.NASC ~ tide, family = tweedie(var.power = 1.5, link.power = 0), data = fishdata_ocean)

#Deviance explained
(shoals_glm_tweedie$null.deviance - shoals_glm_tweedie$deviance) / shoals_glm_tweedie$null.deviance * 100

# Create prediction data
pred_data_overall <- data.frame(tide = c("ebb", "flood"))

# Get predictions on link scale (log)
preds <- predict(shoals_glm_tweedie, 
                 newdata = pred_data_overall, 
                 type = "link", 
                 se.fit = TRUE)

# Calculate CIs on link scale then back-transform
pred_data_overall$fit <- exp(preds$fit)
pred_data_overall$lower <- exp(preds$fit - 1.96 * preds$se.fit)
pred_data_overall$upper <- exp(preds$fit + 1.96 * preds$se.fit)

# Reorder tide
pred_data_overall$tide <- factor(pred_data_overall$tide, levels = c("flood", "ebb"))

# Plot
tweedie_overall_shoals <- ggplot(pred_data_overall, aes(x = tide, y = fit, colour = tide)) +
  geom_point() +
  geom_errorbar(aes(ymin = lower, ymax = upper), 
                width = 0.2) +
  scale_x_discrete(labels = c("ebb" = "Ebb", "flood" = "Flood")) +
  scale_colour_discrete(labels = c("ebb" = "Ebb", "flood" = "Flood")) +
  xlab("Tidal state") + 
  ylab(expression(atop("Fish biomass (NASC: m² nm"^{scriptstyle(-2)}*")", "per 50 m section of survey track"))) +
  labs(colour = "Tidal State") +
  theme_minimal() +
  theme(axis.title = element_text(size = 11),
        axis.text = element_text(size = 10),
        legend.position = "none") +
  theme(plot.margin = unit(c(1, 0.5, 0.5, 1.2), "cm"))

