  theme(panel.grid.major = element_line(colour = "gray80", linewidth = 0.5),
        axis.text.x = element_text(angle = 45, hjust = 1))

# Create polygon of whole study area based on dive locations
study_poly <- dives4_ocean |>
  st_union() |>
  st_convex_hull()

# Create line between north and north channel
cut1 <- st_linestring(rbind(c(-5.675, 57.265), c(-5.605, 57.240)))

# Between north channel and south channel  
cut2 <- st_linestring(rbind(c(-5.675, 57.245), c(-5.605, 57.230)))

# Between south channel and south
cut3 <- st_linestring(rbind(c(-5.675, 57.220), c(-5.605, 57.235)))

cuts <- st_sfc(cut1, cut2, cut3, crs = 4326) # Creates list of cuts

segments <- st_split(study_poly, cuts) |>
  st_collection_extract("POLYGON") |>
  st_sf(region = c("south", "south_channel", "north_channel", "north")) # Names segments

