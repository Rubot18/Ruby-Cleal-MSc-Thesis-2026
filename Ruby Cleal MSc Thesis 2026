## DIVE ANALYSIS ##
dives <- read.csv("pv43_dive.csv") # Load dive file

# Summary dive parameters for Kyle Rhea
dives2 <- subset(dives[which(dives$lat<57.27 & dives$lat>57.20 & dives$lon> -5.67 & dives$lon< -5.605),]) # Subset for dives within study site
temp <- as.POSIXct(as.character(dives2$ds_date), "%Y/%m/%d %H:%M:%S", tz="GMT") # Create datetime object
temp2 <- as.numeric(difftime(temp, "1970/01/01 00:00:00", tz="GMT", units="secs")) # Add time as seconds from specified date
dives2$secs<- temp2 # Add secs field to data frame

# Create the tidal file
tide <- read.csv("tide_KL.csv") # Load tidal file
tide$datetime<- paste(tide$date," ",tide$time, sep="") # Combine the date and time columns

tide = tide[tide$height>3,] # Set high tide threshold
temp <- as.POSIXct(as.character(tide$datetime), "%d/%m/%Y %H:%M", tz="GMT") # Create datetime object
temp2 <- as.numeric(difftime(temp, "1970/01/01 00:00", tz="GMT", units="secs")) # Add time as seconds from specified date
tide$secs<- temp2 # Add secs field to data frame
rm(temp, temp2) # Removes temp and temp2 (no longer needed)

ltide <- data.table(tide, key = "secs" ) # Creates tide data table, specifying to match by seconds variable
lseals <- data.table(dives2, key = "secs" ) # Creates dives data table, specifying to match by seconds variable
 
#  Join based on the key column of the two tables (secs)
#  Roll = "nearest" gives the desired behaviour
#  List( height, secs ) gives the columns you want to return from ltide
tidematch<- ltide[lseals, list(secs, height, datetime) , roll = "nearest" ]
colnames(tidematch) = c("secs", "height", "datetime")
temp <- as.POSIXct(as.character(tidematch$datetime), "%d/%m/%Y %H:%M", tz="GMT") # Create datetime object
temp2 <- as.numeric(difftime(temp, "1970/01/01 00:00", tz="GMT", units="secs")) # Add time as seconds from specified date
tidematch = as.data.frame(tidematch) # Converts 'tidematch' from data table to data frame  
tidematch$secstide = temp2 # Add secs field to data frame
rm(temp, temp2) # Removes temp and temp2 (no longer needed)
dives2<- dives2[order(dives2$secs),] # Sorts by secs column
dives3<- cbind(dives2,tidematch$height, tidematch$secstide) # Combines tide height and secs column to dives
dives3$tidediff = (dives3$secs-dives3[51])/3600 # Difference in hours from high tide where a negative value is the flood tide and a positive value is the ebb tide
dives3$tidefactor<- ifelse(dives3$tidediff< 0, "flood", "ebb") # Creates factor for tidal state (flood/ebb)

dives4 <- dives3[, c("ref", "DE_DATE", "SURF_DUR", "DIVE_DUR", "MAX_DEP", "lat", "lon", "ds_date", "tidediff", "tidefactor")] # Selecting necessary columns

# SPATIAL ANALYSIS OF DIVE DATA 
dives4_sf <- st_as_sf(dives4, coords = c("lon", "lat"), crs = 4326) # Creates spatial file from dives
coast = st_read("SPR_DEC_2022_SC_BGC.shp") # Load coastal file
coast = st_transform(coast, crs = 4326) # Transform coastal file to match CRS

## Creating buffer to remove points on land
dives4_proj <- st_transform(dives4_sf, 32630) # Transform to UTM for accurate metre-based buffer
coast_proj <- st_transform(coast, 32630) 
coastal_buffer <- st_buffer(coast_proj, 20) # Create 20m coastal buffer

dives4_ocean <- dives4_proj[!apply(st_intersects( 
  dives4_proj,
  coastal_buffer,
  sparse = FALSE
), 1, any), ] # Remove points within buffer and on land

dives4_ocean <- st_transform(dives4_ocean, 4326) # Transform back to 4326

## Splitting study site into 4 regions
# Visualise data to choose where to cut
ggplot() + 
  geom_sf(data = coast) +
  geom_sf(data = dives4_ocean, size = 1) +
  coord_sf(xlim = c(-5.67, -5.61),
           ylim = c(57.20, 57.27),
           expand = TRUE) +
  scale_y_continuous(breaks = seq(57.20, 57.27, by = 0.005)) +
