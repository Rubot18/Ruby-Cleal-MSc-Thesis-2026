dives4_ocean <- st_join(dives4_ocean, segments["region"]) # Adding column with region name to dataframe
segments$region <- factor(segments$region, 
                           levels = c("north", "north_channel", "south_channel", "south")) # Ordering regions


######### GAMMs #################################################################################################################################################

# Check classes of variables 
class(dives4_ocean$tidediff) 
class(dives4_ocean$ref)
levels(dives4_ocean$ref)

dives4_ocean$tidediff <- as.numeric(unlist(dives4_ocean$tidediff)) # makes tidal variable numeric
dives4_ocean$ref <- as.factor(dives4_ocean$ref) # makes seal ID field a factor
dives4_ocean$region <- as.factor(dives4_ocean$region) # makes region field a factor

## Full Study Area - Dive Duration Predicted by Tide and Seal ID GAMM ##
full_study_area_model_dive_dur_1 <- gam(DIVE_DUR ~ s(tidediff, bs = "cc", k = 10)  + s(ref, bs = "re"), family = Gamma(link = "log"), data = dives4_ocean, method="REML")
# random effect of seal ID - each seal has a different baseline dive duration but the smooths for each seal are the same.

## Autocorrelation checks
acf(full_study_area_model_dive_dur_1$residuals, plot = TRUE)$acf[2] # Estimate rho - the lag 1 autocorrelation value
# autocorrelation detected 

# Thinning the data to deal with autocorrelation - all subsequent models use thinned data
dives4_ocean_thin = dives4_ocean[seq(1, nrow(dives4_ocean), 10), ] # selecting every 10th row

full_study_area_model_dive_dur_thin <- gam(DIVE_DUR ~ s(tidediff, bs = "cc", k = 10) + s(tidediff, ref, bs = "re"), family = Gamma(link = "log"), data = dives4_ocean_thin, method="REML")

# ACF plot pre-thinning
tiff("acf_pre_thin.tif", width = 90, height = 100, units = "mm", res = 300)
acf(full_study_area_model_dive_dur_1$residuals, main = "ACF of residuals pre-thinning")
dev.off()

# ACF plot post-thinning
tiff("acf_post_thin.tif", width = 90, height = 100, units = "mm", res = 300)
acf(full_study_area_model_dive_dur_thin$residuals, main = "ACF of residuals post-thinning")
dev.off()

acf(full_study_area_model_dive_dur_thin$residuals, plot = TRUE)$acf[2] # Estimate rho post-thinning

# Get exponentiated coefficients for intercept
exp(coef(full_study_area_model_dive_dur_thin))[1:1]

# Extract standard errors for parametric terms
se <- summary(full_study_area_model_dive_dur_thin)$p.table[, "Std. Error"]
coefs <- summary(full_study_area_model_dive_dur_thin)$p.table[, "Estimate"]

# Calculate 95% CI and exponentiate
data.frame(
  estimate = exp(coefs),
  lower = exp(coefs - 1.96 * se),
  upper = exp(coefs + 1.96 * se)
)

# Create prediction data
pred_data <- expand.grid(
  tidediff = seq(min(dives4_ocean_thin$tidediff), max(dives4_ocean_thin$tidediff), length = 100),
  ref = levels(dives4_ocean_thin$ref)[1]  # dummy ref level
)

# Predict on link scale excluding random effect
preds <- predict(full_study_area_model_dive_dur_thin, 
                 newdata = pred_data,
                 type = "link",
                 se.fit = TRUE,
                 exclude = "s(ref)")

# Back-transform predictions and CIs
pred_data$fit <- exp(preds$fit)
pred_data$lower <- exp(preds$fit - 1.96 * preds$se.fit)
pred_data$upper <- exp(preds$fit + 1.96 * preds$se.fit)

# Plot
dive_dur_smooth <- ggplot(pred_data, aes(x = tidediff, y = fit)) +
  geom_ribbon(aes(ymin = lower, ymax = upper), alpha = 0.2)  +
  geom_line(aes(y = lower), linetype = "dashed") +
  geom_line(aes(y = upper), linetype = "dashed") +
  geom_line() +
  geom_vline(xintercept = 0, linetype = "longdash", colour = "gray50") +
  scale_x_continuous(breaks = seq(-6, 6, by = 2)) +
  labs(x = "Time from high water (hours)",
       y = "Predicted dive duration (seconds)") +
  theme_minimal() +
  theme(axis.title = element_text(size = 12),
        axis.text = element_text(size = 10))

ggsave("dive_dur_smooth.tif", dive_dur_smooth, dpi = 300, width = 120, height = 90, units = "mm", bg = "white")

